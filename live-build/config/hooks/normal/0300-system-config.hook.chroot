#!/bin/sh
# Ajustes de sistema: cortafuegos, servicios, permisos.
set -e

# Cortafuegos restrictivo por defecto (ver /etc/nftables.conf)
systemctl enable nftables

# Servicios que NO deben arrancar solos: el analista decide cuándo usarlos.
systemctl disable tor || true
systemctl disable docker || true
systemctl disable containerd || true
systemctl disable clamav-freshclam || true
systemctl disable dnscrypt-proxy || true
# OpenSnitch reescribe reglas de nftables al arrancar (intercepta DNS con nfqueue); se activa
# a demanda: sudo systemctl start opensnitch
systemctl disable opensnitch || true
# La interfaz de OpenSnitch se autoarranca en cada sesión: solo tiene sentido con el demonio activo.
if [ -f /etc/xdg/autostart/opensnitch_ui.desktop ]; then
    sed -i 's|^Exec=.*|Exec=sh -c "systemctl is-active -q opensnitch \&\& exec opensnitch-ui"|' /etc/xdg/autostart/opensnitch_ui.desktop
fi
# USBGuard: en el chroot no hay dispositivos, así que su política generada al instalar está vacía y
# bloquearía teclados y discos USB en hardware real. Se activa a demanda tras generar la política:
#   sudo usbguard generate-policy > /etc/usbguard/rules.conf && sudo systemctl enable --now usbguard
systemctl disable usbguard || true

# Trazabilidad y actualizaciones de seguridad automáticas (ver docs/opsec.md)
systemctl enable auditd || true
systemctl enable unattended-upgrades || true
sysctl -e -p /etc/sysctl.d/90-ctidistro.conf >/dev/null 2>&1 || true

# Flathub para aplicaciones extra bajo demanda (cti-extras)
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# Grupos del usuario en vivo (live-config lo crea en el arranque).
mkdir -p /etc/live/config.conf.d
cat > /etc/live/config.conf.d/10-ctidistro.conf <<'CONF'
LIVE_USER_DEFAULT_GROUPS="audio cdrom dip floppy video plugdev netdev sudo docker wireshark"
LIVE_USER_FULLNAME="Analista CTI"
CONF

# Wireshark: permitir captura a miembros del grupo wireshark
echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections
dpkg-reconfigure -f noninteractive wireshark-common || true

# Scripts propios ejecutables
chmod 0755 /usr/local/bin/cti-* /usr/local/bin/pdfid 2>/dev/null || true

# Directorio de stacks accesible
mkdir -p /opt/cti/stacks
chmod 0755 /opt/cti /opt/cti/stacks
