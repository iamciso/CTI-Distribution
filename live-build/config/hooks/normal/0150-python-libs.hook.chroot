#!/bin/sh
# Crea el entorno /opt/cti/venv con librerías CTI y lo registra como kernel de Jupyter.
set -e

MANIFEST=/opt/cti/manifests/python-libs.txt
VENV=/opt/cti/venv
export PIP_NO_CACHE_DIR=1

python3 -m venv --system-site-packages "$VENV"
"$VENV/bin/pip" install --upgrade pip ipykernel

grep -vE '^\s*(#|$)' "$MANIFEST" | while read -r spec; do
    echo ">>> pip install $spec"
    if ! "$VENV/bin/pip" install "$spec"; then
        echo "!!! fallo instalando $spec" >&2
        echo "$spec" >> /opt/cti/manifests/python-libs-failed.txt
    fi
done

"$VENV/bin/python" -m ipykernel install --name cti --display-name "Python (CTI)"

# Acceso directo: "cti-python" abre el intérprete con las librerías cargadas
ln -sf "$VENV/bin/python" /usr/local/bin/cti-python
rm -rf /root/.cache/pip
