#!/bin/sh
# Entorno /opt/cti/venv con librerías CTI (ver /opt/cti/lib/install-venv.sh y manifests/python-libs.txt).
# El lanzador /usr/local/bin/cti-python ejecuta el intérprete del venv; no puede ser un enlace simbólico
# porque Python busca pyvenv.cfg junto a la ruta con la que se le invoca.
set -e
sh /opt/cti/lib/install-venv.sh
