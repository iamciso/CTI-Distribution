# Reduce el tamaño de la imagen: no se instala la documentación de los paquetes (se conservan los
# ficheros copyright por licencia) ni las traducciones distintas de español e inglés.
# Se aplica antes de instalar paquetes (includes.chroot_before_packages).
path-exclude=/usr/share/doc/*
path-include=/usr/share/doc/*/copyright
path-exclude=/usr/share/locale/*
path-include=/usr/share/locale/es*
path-include=/usr/share/locale/en*
path-include=/usr/share/locale/locale.alias
path-exclude=/usr/share/info/*
path-exclude=/usr/share/lintian/*
path-exclude=/usr/share/linda/*
