# Ajustes de escritorio por defecto de CTI Distribution (se compilan con "dconf update").
# El usuario puede cambiarlos; para bloquearlos, añadir claves en local.d/locks/.

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com', 'arcmenu@arcmenu.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'cti-netcheck.desktop', 'cti-evidence.desktop', 'org.keepassxc.KeePassXC.desktop', 'cherrytree.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='99.0'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
intellihide-mode='ALL_WINDOWS'
autohide-in-fullscreen=true
transparency-mode='DYNAMIC'
running-indicator-style='DOTS'
show-trash=false
show-mounts=false
show-show-apps-button=true
show-apps-at-top=false
click-action='minimize-or-overview'
scroll-action='cycle-windows'
dash-max-icon-size=48
custom-theme-shrink=true
multi-monitor=true

[org/gnome/shell/extensions/arcmenu]
position-in-panel='Left'
# Disposición con la lista de categorías a la vista (estilo Kali/Whisker)
menu-layout='Whisker'
# Evita el aviso "ArcMenu vNN released" en cada primer inicio de sesión
update-notifier-project-version=65
menu-button-appearance='Icon'
show-activities-button=false

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='blue'
icon-theme='Papirus-Dark'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='DejaVu Sans Mono 11'
enable-hot-corners=false
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true
font-antialiasing='rgba'
font-hinting='slight'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Bold 11'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/ctidistro/ctidistro.png'
picture-uri-dark='file:///usr/share/backgrounds/ctidistro/ctidistro.png'
picture-options='zoom'
primary-color='#0d131b'
secondary-color='#0d131b'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/ctidistro/ctidistro.png'
primary-color='#0d131b'
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
remove-old-temp-files=true
remove-old-trash-files=true
report-technical-problems=false
send-software-usage-stats=false

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'
show-delete-permanently=true

[org/gnome/nautilus/list-view]
use-tree-view=true

[org/gnome/terminal/legacy]
theme-variant='dark'
new-terminal-mode='window'

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
visible-name='CTI'
use-theme-colors=false
background-color='#0d131b'
foreground-color='#d8dee9'
use-system-font=false
font='DejaVu Sans Mono 11'
use-transparent-background=true
background-transparency-percent=6
scrollback-unlimited=true
audible-bell=false

[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/sound]
event-sounds=false
