## Reglas base de auditd para la estación del analista: trazabilidad de cambios sensibles
## sin inundar el registro. Ver docs/opsec.md. Las reglas se cargan con augenrules al arrancar.
-D
-b 8192
-f 1
## Identidad y privilegios
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k privilege_escalation
## Configuración del sistema y de la propia auditoría
-w /etc/audit/ -p wa -k audit_config
-w /etc/nftables.conf -p wa -k firewall
-w /etc/ssh/ -p wa -k ssh_config
-w /etc/NetworkManager/ -p wa -k network_config
-w /etc/apt/ -p wa -k package_sources
-w /etc/cron.d/ -p wa -k cron
-w /etc/systemd/ -p wa -k systemd
## Módulos del kernel y montajes
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k mounts
## Evidencias del analista: escrituras y borrados en ~/Evidence
-w /home/analyst/Evidence/ -p wa -k evidence
## Hacer inmutable la configuración hasta el próximo arranque (descomentar en sistemas instalados)
#-e 2
