#!/bin/sh
# Smoke test para ejecutar DENTRO de un sistema arrancado (live o instalado):
#   cti-smoke-test            (en la imagen)
#   tests/smoke-test.sh       (desde el repositorio)
# Verifica que las herramientas clave están instaladas.
set -u

# openvpn, nft, etc. viven en /usr/sbin, que no está en el PATH del usuario analyst.
PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
export PATH

tools="
nmap amass theHarvester recon-ng dnstwist whatweb exiftool mat2 gallery-dl yt-dlp instaloader
olevba yara clamscan ssdeep binwalk jupyter-notebook pandoc
tor torsocks proxychains4 macchanger wg openvpn nft firejail onionshare-cli age
sherlock maigret holehe socialscan ghunt h8mail bbot sigma capa pdfid censys
subfinder dnsx httpx katana waybackurls assetfinder gau gowitness vt
uncover asnmap cdncheck tlsx hakrawler metabigor phoneinfoga gitleaks trufflehog
ignorant toutatis xeuledoc socid_extractor telegram-phone-number-checker crosslinked auto-archiver zoomeye greynoise
chromium foremost photorec stegseek zbarimg jupyter-lab
gnome-shell gdm3 nautilus gnome-terminal
cti-netcheck cti-evidence cti-python cti-run cti-smoke-test
docker
"

fail=0
for t in $tools; do
    if command -v "$t" >/dev/null 2>&1; then
        printf 'OK    %s\n' "$t"
    else
        printf 'FALTA %s\n' "$t"
        fail=$((fail + 1))
    fi
done

echo
echo "Herramientas ausentes: $fail"
for f in /opt/cti/manifests/pipx-failed.txt /opt/cti/manifests/go-failed.txt /opt/cti/manifests/python-libs-failed.txt; do
    [ -s "$f" ] && { echo "Fallos registrados en $f:"; cat "$f"; }
done
[ "$fail" -eq 0 ]
