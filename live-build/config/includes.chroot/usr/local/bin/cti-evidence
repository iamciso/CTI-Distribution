#!/bin/sh
# Registra un fichero como evidencia: hash SHA-256, marca de tiempo UTC y nota.
# Uso: cti-evidence <fichero> [nota]
# El registro se acumula en ~/Evidence/manifest.csv
set -eu

[ $# -ge 1 ] || { echo "Uso: cti-evidence <fichero> [nota]" >&2; exit 1; }
file=$1
note=${2:-}
[ -f "$file" ] || { echo "No existe: $file" >&2; exit 1; }

dir="$HOME/Evidence"
manifest="$dir/manifest.csv"
mkdir -p "$dir"
[ -f "$manifest" ] || echo "timestamp_utc,sha256,size_bytes,path,host,analyst,note" > "$manifest"

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
sha=$(sha256sum "$file" | awk '{print $1}')
size=$(stat -c %s "$file")
abs=$(realpath "$file")
note_esc=$(printf '%s' "$note" | sed 's/"/""/g')

printf '%s,%s,%s,"%s",%s,%s,"%s"\n' "$ts" "$sha" "$size" "$abs" "$(hostname)" "$(id -un)" "$note_esc" >> "$manifest"
echo "Registrado: $abs"
echo "SHA-256   : $sha"
echo "Manifiesto: $manifest"
